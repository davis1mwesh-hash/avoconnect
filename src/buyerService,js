/**
 * AvoConnect Sourcing & Offers API Handlers
 * Integrates directly with your Supabase client instance
 */

// 1. Post a new buying tender from an exporter/company profile
export async function publishRequirement(supabase, requirementData) {
  const { buyerId, companyName, variety, location, targetPrice, minQty, notes } = requirementData;
  
  const { data, error } = await supabase
    .from("buyer_requirements")
    .insert({
      buyer_id: buyerId,
      company_name: companyName,
      variety: variety,
      preferred_location: location,
      target_price_per_kg: Number(targetPrice),
      min_quantity_kg: Number(minQty),
      additional_notes: notes,
      status: 'active'
    })
    .select()
    .single();

  if (error) throw error;
  return data;
}

// 2. Fetch all active sourcing requirements for the Farmer Dashboard
export async function fetchActiveRequirements(supabase) {
  const { data, error } = await supabase
    .from("buyer_requirements")
    .select("*")
    .eq("status", "active")
    .order("created_at", { ascending: false });

  if (error) throw error;
  return data || [];
}

// 3. Submit an offer from a farmer's crop listing to fulfill a buyer's requirement
export async function submitFarmerOffer(supabase, offerData) {
  const { requirementId, listingId, farmerId, buyerId, message } = offerData;

  // Insert into buyer_offers cross-reference table
  const { data: offer, error: offerError } = await supabase
    .from("buyer_offers")
    .insert({
      requirement_id: requirementId,
      listing_id: listingId,
      farmer_id: farmerId,
      status: "pending"
    })
    .select()
    .single();

  if (offerError) throw offerError;

  // Automatically trigger a push notification to the buyer's bell icon
  await supabase.from("notifications").insert({
    user_id: buyerId,
    type: "order", // Uses your existing notification icon mapping
    title: "New Harvest Offer Received! 🥑",
    message: message || "A farmer has offered to fulfill your sourcing requirement. View your dashboard to check details."
  });

  return offer;
}

// 4. Fetch incoming farm offers for a specific buyer's dashboard
export async function fetchOffersForBuyer(supabase, buyerId) {
  const { data, error } = await supabase
    .from("buyer_offers")
    .select(`
      *,
      buyer_requirements!inner(*),
      listings!inner(variety, quantity_kg, price_per_kg, harvest_date, certification, county),
      profiles!buyer_offers_farmer_id_fkey(name, phone)
    `)
    .eq("buyer_requirements.buyer_id", buyerId)
    .order("created_at", { ascending: false });

  if (error) throw error;
  return data || [];
}